---
// Layout.astro - ActionPath Africa
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ActionPath Africa | Designing change, inspiring growth",
  description = "Designing change, inspiring growth — ActionPath Africa delivers transformative livelihood training and capacity building across the continent.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23c0392b'/%3E%3Cpath fill='%23f8fafc' d='M30,40 L45,30 L60,40 L60,60 L45,70 L30,60 Z' opacity='0.9'/%3E%3C/svg%3E"
    />

    <style is:global>
      /* ═══════════════════════════════════
         VARIABLES
      ═══════════════════════════════════ */
      :root {
        --red: #c0392b;
        --red-dark: #a93226;
        --red-soft: rgba(192, 57, 43, 0.1);
        --green: #27ee31;
        --green-lt: #27f731;
        --charcoal: #1e293b;
        --gray-dk: #334155;
        --gray-md: #64748b;
        --gray-sf: #f1f5f9;
        --white: #ffffff;
        --bg: #fefcf8;
        --border: #e2e8f0;
        --sh-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
        --sh-md: 0 8px 30px rgba(0, 0, 0, 0.09);
        --sh-lg: 0 20px 50px rgba(0, 0, 0, 0.12);
        --nav-h: 76px;
        --ease: all 0.22s ease;
      }

      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
        max-width: 100%;
      }

      body {
        font-family: "DM Sans", system-ui, sans-serif;
        background: var(--bg);
        color: var(--charcoal);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
        max-width: 100%;
        width: 100%;
      }

      a {
        text-decoration: none;
        color: inherit;
        transition: var(--ease);
      }
      img {
        max-width: 100%;
      }

      .container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* Fullscreen main content — no container restriction */
      main {
        min-height: 60vh;
        width: 100%;
      }

      /* ═══════════════════════════════════
         TOPBAR
      ═══════════════════════════════════ */
      .topbar {
        background: var(--charcoal);
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.78rem;
        padding: 0.4rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        position: relative;
        z-index: 1001;
      }
      .topbar a {
        color: var(--green-lt);
        font-weight: 600;
      }
      .topbar-contacts {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .topbar-contacts span {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .topbar-contacts i {
        color: var(--green);
        font-size: 0.75rem;
      }
      .topbar-social {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .topbar-social a {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
      }
      .topbar-social a:hover {
        color: var(--green-lt);
      }

      /* ═══════════════════════════════════
         HEADER - No red line
      ═══════════════════════════════════ */
      header {
        background: var(--white);
        box-shadow: var(--sh-sm);
        position: sticky;
        top: 0;
        z-index: 1000;
      }
      nav.main-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: var(--nav-h);
        gap: 1rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      /* Logo with image + text */
      .logo {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
        min-width: 0;
        overflow: hidden;
      }
      .logo-img {
        height: 56px;
        width: auto;
        display: block;
        flex-shrink: 0;
      }
      .logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
        min-width: 0;
      }
      .logo-main {
        font-family: "Outfit", sans-serif;
        font-weight: 900;
        font-size: 1.92rem;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, var(--red), var(--red-dark));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        line-height: 1;
        white-space: nowrap;
      }
      .logo-tagline {
        font-family: "DM Sans", sans-serif;
        font-size: 0.72rem;
        font-weight: 300;
        font-style: italic;
        color: var(--green);
        letter-spacing: 0.01em;
        margin-top: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* ── Desktop nav links ── */
      .nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
      }
      .nav-item {
        position: relative;
      }

      .nav-trigger {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: "DM Sans", sans-serif;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--charcoal);
        padding: 0.5rem 0.85rem;
        border-radius: 8px;
        cursor: pointer;
        border: none;
        background: none;
        transition: var(--ease);
        white-space: nowrap;
      }
      .nav-trigger .chevron {
        font-size: 0.65rem;
        color: var(--gray-md);
        transition: transform 0.22s;
      }
      .nav-item:hover > .nav-trigger,
      .nav-item.is-open > .nav-trigger {
        color: var(--red);
        background: var(--red-soft);
      }
      .nav-item:hover > .nav-trigger .chevron,
      .nav-item.is-open > .nav-trigger .chevron {
        transform: rotate(180deg);
        color: var(--red);
      }
      .nav-trigger.is-active {
        color: var(--red);
      }
      .nav-trigger.is-active::after {
        content: "";
        position: absolute;
        bottom: -1px;
        left: 0.85rem;
        right: 0.85rem;
        height: 2px;
        background: var(--red);
        border-radius: 2px;
      }
      .nav-cta {
        background: var(--red) !important;
        color: white !important;
        padding: 0.5rem 1.2rem !important;
        border-radius: 40px !important;
      }
      .nav-cta:hover {
        background: var(--red-dark) !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(192, 57, 43, 0.35);
      }

      /* Dropdown */
      .dropdown {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        background: var(--white);
        min-width: 260px;
        border-radius: 16px;
        box-shadow: var(--sh-md);
        border: 1px solid var(--border);
        padding: 0.5rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition:
          opacity 0.2s ease,
          transform 0.2s ease,
          visibility 0.2s;
        z-index: 1001;
      }
      .nav-item:hover > .dropdown,
      .nav-item.is-open > .dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .dropdown-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.55rem 0.9rem;
        font-size: 0.84rem;
        font-weight: 500;
        color: var(--gray-dk);
        border-radius: 10px;
        border-left: 3px solid transparent;
        transition: var(--ease);
      }
      .dropdown-link i {
        width: 18px;
        text-align: center;
        font-size: 0.8rem;
        color: var(--gray-md);
        flex-shrink: 0;
      }
      .dropdown-link:hover {
        background: var(--red-soft);
        color: var(--red);
        border-left-color: var(--red);
        padding-left: 1.1rem;
      }
      .dropdown-link:hover i {
        color: var(--red);
      }

      /* Megamenu */
      .megamenu {
        position: absolute;
        top: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        background: var(--white);
        width: 740px;
        max-width: 85vw;
        border-radius: 20px;
        box-shadow: var(--sh-lg);
        border: 1px solid var(--border);
        padding: 1.5rem;
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.22s ease,
          transform 0.22s ease,
          visibility 0.22s;
        z-index: 1001;
      }
      .nav-item:hover > .megamenu,
      .nav-item.is-open > .megamenu {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }
      .megamenu-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem 1.5rem;
      }
      .mega-section {
        margin-bottom: 0.25rem;
      }
      .mega-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: "Outfit", sans-serif;
        font-size: 0.8rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--red);
        padding: 0.5rem 0 0.75rem;
        margin-bottom: 0.25rem;
        border-bottom: 2px solid var(--red-soft);
        text-decoration: none;
        transition: var(--ease);
      }
      .mega-section-title i {
        font-size: 0.85rem;
      }
      a.mega-section-title:hover {
        color: var(--red-dark);
        gap: 10px;
      }
      .mega-links {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
      }
      .mega-links .dropdown-link {
        padding: 0.45rem 0.6rem;
        font-size: 0.82rem;
      }

      /* Responsive megamenu on smaller desktops */
      @media (max-width: 880px) {
        .megamenu {
          width: 680px;
        }
        .megamenu-grid {
          gap: 0.75rem;
        }
        .mega-links .dropdown-link {
          font-size: 0.78rem;
          padding: 0.4rem 0.5rem;
        }
      }

      /* Support Our Work Button - Black text + Green background */
      .nav-support {
        background: var(--green) !important;
        color: var(--charcoal) !important;
        border: 1px solid var(--green) !important;
        padding: 0.5rem 1.2rem !important;
        border-radius: 40px !important;
        font-weight: 700 !important;
      }
      .nav-support:hover {
        background: var(--red-dark) !important;
        color: white !important;
        border-color: var(--red-dark) !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(169, 50, 38, 0.3);
      }

      /* ═══════════════════════════════════
         HAMBURGER
      ═══════════════════════════════════ */
      .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        flex-shrink: 0;
        transition: background 0.2s;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
      }
      .hamburger:hover {
        background: var(--red-soft);
      }
      .hamburger span {
        display: block;
        width: 100%;
        height: 2.5px;
        background: var(--charcoal);
        border-radius: 3px;
        transition:
          transform 0.3s ease,
          opacity 0.3s ease;
        transform-origin: center;
      }
      .hamburger.is-open span:nth-child(1) {
        transform: translateY(7.5px) rotate(45deg);
      }
      .hamburger.is-open span:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
      }
      .hamburger.is-open span:nth-child(3) {
        transform: translateY(-7.5px) rotate(-45deg);
      }

      /* ═══════════════════════════════════
         OVERLAY
      ═══════════════════════════════════ */
      #nav-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(2px);
        z-index: 9998;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      #nav-overlay.is-visible {
        opacity: 1;
        pointer-events: auto;
      }

      /* ═══════════════════════════════════
         MOBILE DRAWER
      ═══════════════════════════════════ */
      #mobile-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        background: var(--white);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transform: translateX(100%);
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        padding-top: env(safe-area-inset-top);
        padding-bottom: env(safe-area-inset-bottom);
      }
      #mobile-nav.is-open {
        transform: translateX(0);
      }

      .mnav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 2px solid var(--border);
        flex-shrink: 0;
        min-height: 72px;
        gap: 0.5rem;
      }
      .mnav-close {
        width: 44px;
        height: 44px;
        background: var(--gray-sf);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--charcoal);
        transition: background 0.2s;
        flex-shrink: 0;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
      }
      .mnav-close:hover {
        background: var(--red-soft);
        color: var(--red);
      }

      .mnav-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 1.5rem 3rem;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior: contain;
      }

      .mnav-row {
        border-bottom: 1px solid var(--border);
      }
      .mnav-row-link,
      .mnav-row-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 0.9rem 0;
        min-height: 48px;
        background: none;
        border: none;
        cursor: pointer;
        font-family: "DM Sans", sans-serif;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--charcoal);
        text-align: left;
        gap: 8px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
      }
      .mnav-row-label {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .mnav-row-label i {
        width: 22px;
        text-align: center;
        color: var(--red);
        font-size: 0.85rem;
        flex-shrink: 0;
      }
      .mnav-chevron {
        font-size: 0.7rem;
        color: var(--gray-md);
        transition: transform 0.25s;
        flex-shrink: 0;
      }
      .mnav-row.is-open .mnav-chevron {
        transform: rotate(180deg);
        color: var(--red);
      }

      .mnav-sub {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease;
      }
      .mnav-row.is-open .mnav-sub {
        max-height: 2000px;
      }

      .mnav-sub-section {
        padding: 0.25rem 0 0.75rem;
      }
      .mnav-sub-title {
        font-family: "Outfit", sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--red);
        padding: 0.6rem 0.5rem 0.3rem;
        margin-top: 0.25rem;
      }
      /* Clickable sub-title link variant */
      a.mnav-sub-title {
        display: flex;
        align-items: center;
        gap: 6px;
        border-radius: 6px;
        transition: var(--ease);
        text-decoration: none;
      }
      a.mnav-sub-title:hover {
        background: var(--red-soft);
        padding-left: 0.75rem;
      }
      .mnav-sub-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.65rem 0.5rem;
        min-height: 44px;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--gray-dk);
        border-radius: 8px;
        transition: var(--ease);
        -webkit-tap-highlight-color: transparent;
      }
      .mnav-sub-link i {
        width: 18px;
        text-align: center;
        font-size: 0.78rem;
        color: var(--gray-md);
        flex-shrink: 0;
      }
      .mnav-sub-link:hover {
        background: var(--red-soft);
        color: var(--red);
      }
      .mnav-sub-link:hover i {
        color: var(--red);
      }

      .mnav-cta {
        margin-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .mnav-cta a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0.95rem 1.5rem;
        border-radius: 40px;
        font-weight: 700;
        font-size: 0.9rem;
        min-height: 48px;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
      }
      .mnav-cta-primary {
        background: var(--red);
        color: white;
      }
      .mnav-cta-secondary {
        border: 2px solid var(--green);
        color: var(--charcoal);
      }
      .mnav-cta-support {
        background: var(--green);
        color: var(--charcoal);
        border: 1px solid var(--green);
        font-weight: 700;
      }
      .mnav-cta-support:hover {
        background: var(--red-dark);
        color: white;
        border-color: var(--red-dark);
      }

      /* ═══════════════════════════════════
         FOOTER
      ═══════════════════════════════════ */
      footer {
        background: var(--charcoal);
        color: rgba(255, 255, 255, 0.82);
      }
      .footer-top {
        padding: 3.5rem 0 2.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.2fr;
        gap: 2.5rem;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      .footer-logo-main {
        font-family: "Outfit", sans-serif;
        font-weight: 900;
        font-size: 1.5rem;
        background: linear-gradient(135deg, var(--red), #e74c3c);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        display: block;
        margin-bottom: 4px;
      }
      .footer-logo-tag {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--green);
        letter-spacing: 0.02em;
        margin-bottom: 1rem;
        display: block;
      }
      .footer-brand p {
        font-size: 0.85rem;
        line-height: 1.75;
        color: rgba(255, 255, 255, 0.65);
        max-width: 280px;
        margin-bottom: 0.75rem;
      }
      .footer-reg {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: 1.25rem;
        line-height: 1.5;
      }
      .footer-reg i {
        color: var(--green);
        margin-right: 5px;
        font-size: 0.7rem;
      }
      .footer-social {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .footer-social a {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.65);
        transition: var(--ease);
      }
      .footer-social a:hover {
        background: var(--red);
        border-color: var(--red);
        color: white;
        transform: translateY(-2px);
      }
      .footer-col h4 {
        font-family: "Outfit", sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        color: var(--green-lt);
        margin-bottom: 1rem;
        text-transform: uppercase;
      }
      .footer-col ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .footer-col ul li a {
        font-size: 0.84rem;
        color: rgba(255, 255, 255, 0.65);
        display: flex;
        align-items: center;
        gap: 7px;
        transition: var(--ease);
      }
      .footer-col ul li a i {
        font-size: 0.7rem;
        color: var(--green);
        width: 14px;
      }
      .footer-col ul li a:hover {
        color: white;
        padding-left: 4px;
      }
      .footer-contact-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 0.84rem;
        color: rgba(255, 255, 255, 0.65);
        margin-bottom: 0.75rem;
        line-height: 1.5;
      }
      .footer-contact-item i {
        color: var(--green);
        font-size: 0.85rem;
        margin-top: 2px;
        flex-shrink: 0;
        width: 16px;
        text-align: center;
      }
      .footer-contact-item a {
