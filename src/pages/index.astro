const deliveryModes = [
  {
    icon: "fas fa-chalkboard-user",
    title: "Community-Based Training",
    description:
      "On-the-ground programs delivered within communities, respecting local contexts and cultural norms.",
    href: "/delivery/community-training",
  },
  {
    icon: "fas fa-laptop",
