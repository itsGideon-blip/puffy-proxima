---

<Layout
  title="ActionPath Africa | Livelihood Transformation for Resilient Communities"
  description="Empowering communities affected by conflict, drought, poverty, and disease through sustainable livelihood training across Africa."
>
  <!-- ═══════════════════════════════════════ HERO SECTION ═══════════════════════════════════════ -->
  <section class="hero premium-hero full-width">
    <div class="hero-gallery" id="heroGallery">
      {
        heroImages.map((img, idx) => (
          <div
            class={`hero-slide${idx === 0 ? " is-active" : ""}`}
            style={`background-image: url('${img}');`}
          />
        ))
      }
      <div class="hero-wipe" id="heroWipe"></div>
      <div class="hero-wipe-edge" id="heroWipeEdge"></div>
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content premium-hero-content">
      <div class="hero-accent-badge">Since 2015 • East Africa</div>
      <h1 class="hero-title" id="heroTitle">
        <span class="hero-line hero-line-1">Building resilient</span>
        <span class="hero-line hero-line-2">livelihoods for</span>
        <span class="hero-line hero-line-3 hero-line-green"
          >communities in crisis</span
        >
      </h1>
      <p class="hero-desc">
        We design and deliver transformative livelihood training programs that
        empower youth, women, and marginalized communities across Africa. Our
        holistic approach creates impact that lasts beyond donor cycles.
      </p>
      <div class="hero-buttons">
        <a href="#services" class="btn-primary btn-premium smooth-scroll"
          ><i class="fas fa-seedling"></i> Explore Services</a
        >
        <a href="/contact" class="btn-outline-premium"
          ><i class="fas fa-handshake"></i> Partner With Us</a
        >
      </div>
      <div class="hero-scroll-indicator">
        <span>Scroll to explore</span>
        <i class="fas fa-arrow-down"></i>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ STATS STRIP ═══════════════════════════════════════ -->
  <section class="stats-strip full-width">
    <div class="stats-container">
      {
        stats.map((stat) => (
          <div class="stat-item" key={stat.label}>
            <i class={stat.icon} />
            <div class="stat-number">
              <span
                class="stat-count"
                data-target={stat.value}
                data-suffix={stat.suffix}
                data-prefix={stat.prefix}
              >
                0
              </span>
            </div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════════════════════════════ WELCOME SECTION ═══════════════════════════════════════ -->
  <section class="welcome-section full-width">
    <div class="section-inner">
      <div class="welcome-grid">
        <div class="welcome-text">
          <div class="section-eyebrow">
            <i class="fas fa-compass"></i> Our Purpose
          </div>
          <h2>Welcome to <span class="accent-red">ActionPath Africa</span></h2>
          <div class="section-divider left"></div>
          <p class="welcome-intro">
            At ActionPath Africa, we design and deliver transformative
            livelihood training programs that equip youth, women, and
            marginalized communities with practical skills, entrepreneurial
            confidence, and the psychosocial resilience to break cycles of
            poverty.
          </p>
          <p>
            Our approach is holistic and context-specific. Every program is
            built in partnership with communities and aligned to national
            development strategies, the SDGs, and Africa's Agenda 2063, ensuring
            impact that outlasts donor cycles and builds genuinely
            self-sustaining livelihoods.
          </p>
          <div class="welcome-highlights">
            <div class="welcome-highlight">
              <i class="fas fa-check-circle"></i> 15,000+ lives transformed
            </div>
            <div class="welcome-highlight">
              <i class="fas fa-check-circle"></i> 28+ communities reached
            </div>
            <div class="welcome-highlight">
              <i class="fas fa-check-circle"></i> 87% income improvement
            </div>
          </div>
          <a href="/about" class="btn-primary"
            ><i class="fas fa-arrow-right"></i> Learn More About Us</a
          >
        </div>
        <div class="welcome-image-wrapper">
          <div class="welcome-image">
            <img
              src="/welcome-community.webp"
              alt="Empowered community members"
              class="welcome-img-static"
              loading="lazy"
            />
            <div class="welcome-img-caption">
              <i class="fas fa-users"></i> 15,000+ lives transformed across Africa
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ PITCHING DEMO IMAGE (NEW) ═══════════════════════════════════════ -->
  <section class="pitching-demo-section full-width">
    <div class="section-inner">
      <div class="pitching-demo-container">
        <div class="pitching-demo-content">
          <div class="section-eyebrow demo-eyebrow">
            <i class="fas fa-chalkboard"></i> Our Impact In Action
          </div>
          <h2>
            Transforming <span class="accent-red">Communities</span> Through <span
              class="accent-green">Livelihood Training</span
            >
          </h2>
          <div class="section-divider left"></div>
          <p>
            Our holistic development framework brings together community
            partnerships and content specific programs to help achieve both
            local and global goals.
          </p>
          <a href="/contact" class="btn-primary"
            ><i class="fas fa-play-circle"></i> Contact Us for Details</a
          >
        </div>
        <div class="pitching-demo-image">
          <img
            src="/pitching-demo.webp"
            alt="ActionPath Africa training session in action - community members engaged in livelihood training"
            loading="lazy"
          />
          <div class="image-overlay-glow"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ OUR SERVICES SECTION ═══════════════════════════════════════ -->
  <section id="services" class="services-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-cogs"></i> What We Offer
        </div>
        <h2>Our <span class="accent-red">Focus Areas</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Comprehensive capacity-building solutions for sustainable community
          development
        </p>
      </div>

      <!-- Training Areas -->
      <div class="services-category">
        <div class="category-header">
          <div class="category-icon">
            <i class="fas fa-chalkboard-user"></i>
          </div>
          
          <div class="category-line"></div>
        </div>
        <div class="training-grid">
          {
            trainingCategories.map((category) => (
              <div class="training-card-wrapper" key={category.title}>
                <a href={category.href} class="training-card">
                  <div class="training-img-wrap">
                    <img
                      src={category.image}
                      alt={category.title}
                      class="training-img"
                      loading="lazy"
                    />
                    <div class="training-tag">{category.tag}</div>
                  </div>
                  <div class="training-body">
                    <div class="training-icon">
                      <i class={category.icon} />
                    </div>
                    <h4 class="training-title">{category.title}</h4>
                    <p class="training-desc">{category.description}</p>
                  </div>
                </a>
                <div class="training-sub-items">
                  {category.subItems.map((sub) => (
                    <a href={sub.link} class="training-sub-link" key={sub.name}>
                      <i class="fas fa-angle-right" /> {sub.name}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="category-cta">
          <a href="/what-we-do/training" class="btn-outline-dark"
            ><i class="fas fa-arrow-right"></i> Explore All Training Areas</a
          >
        </div>
      </div>

      <!-- Consultancy -->
      <div class="services-category consultancy-category">
        <div class="category-header">
          <div class="category-icon"><i class="fas fa-briefcase"></i></div>
          
          <div class="category-line"></div>
        </div>
        <div class="consultancy-grid">
          {
            consultancyItems.map((item) => (
              <a href={item.href} class="consultancy-card" key={item.title}>
                <div class="consultancy-icon">
                  <i class={item.icon} />
                </div>
                <h4 class="consultancy-title">{item.title}</h4>
                <p class="consultancy-desc">{item.description}</p>
                <span class="consultancy-link">
                  Learn more <i class="fas fa-arrow-right" />
                </span>
              </a>
            ))
          }
        </div>
        <div class="category-cta">
          <a href="/what-we-do/consultancy" class="btn-outline-dark"
            ><i class="fas fa-arrow-right"></i> Explore Consultancy Services</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ LIVELIHOOD TRAINING PROGRAMS ═══════════════════════════════════════ -->
  <section class="livelihood-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-tree"></i> Our Expertise
        </div>
        <h2>Livelihood <span class="accent-green">Training Programs</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Comprehensive programs designed to build resilience against poverty,
          unemployment, and climate shocks
        </p>
      </div>
      <div class="livelihood-grid">
        {
          livelihoodPrograms.map((program, idx) => (
            <div
              class="livelihood-card"
              key={program.title}
              style={`--card-color: ${program.color}; --card-accent: ${program.accent}; animation-delay: ${idx * 0.12}s`}
            >
              <div class="livelihood-card-top">
                <div
                  class="livelihood-icon"
                  style={`background: ${program.accent}; color: ${program.color};`}
                >
                  <i class={program.icon} />
                </div>
                <h3 class="livelihood-title">{program.title}</h3>
              </div>
              <p class="livelihood-desc">{program.description}</p>
              <div
                class="livelihood-bar"
                style={`background: ${program.color};`}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ LIVELIHOOD TRAINING TOOLKIT ═══════════════════════════════════════ -->
  <section class="toolkit-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow toolkit-eyebrow">
          <i class="fas fa-toolbox"></i> Our Methodology
        </div>
        <h2 class="toolkit-heading">
          Livelihood Training <span class="accent-green">Toolkit</span>
        </h2>
        <div class="section-divider"></div>
        <p class="section-subtitle toolkit-subtitle">
          An integrated framework combining psychosocial support, vocational
          skills, and enterprise development for holistic community empowerment
        </p>
      </div>

      <!-- Outcome bar -->
      <div class="toolkit-outcome-strip">
        <div class="outcome-item">
          <i class="fas fa-bolt"></i><span
            >Short-term: Certified skills &amp; savings culture</span
          >
        </div>
        <div class="outcome-divider"></div>
        <div class="outcome-item">
          <i class="fas fa-rocket"></i><span
            >Medium-term: New enterprises &amp; improved income</span
          >
        </div>
        <div class="outcome-divider"></div>
        <div class="outcome-item">
          <i class="fas fa-globe-africa"></i><span
            >Long-term: Resilient, self-sustaining communities</span
          >
        </div>
      </div>

      <div class="toolkit-grid">
        {
          toolkitSections.map((toolkit, idx) => (
            <div
              class="toolkit-card"
              key={toolkit.title}
              style={`--tk-color: ${toolkit.color}; animation-delay: ${idx * 0.1}s`}
            >
              <div class="toolkit-number">{toolkit.number}</div>
              <div class="toolkit-icon-wrap" style={`color: ${toolkit.color};`}>
                <i class={toolkit.icon} />
              </div>
              <h3 class="toolkit-title" style={`color: ${toolkit.color};`}>
                {toolkit.title}
              </h3>
              <p class="toolkit-desc">{toolkit.description}</p>
              <div class="toolkit-tags">
                {toolkit.tools.map((tool) => (
                  <span
                    class="toolkit-tag"
                    key={tool}
                    style={`border-color: ${toolkit.color}; color: ${toolkit.color};`}
                  >
                    {tool}
                  </span>
                ))}
              </div>
              <div class="toolkit-outcome-row">
                <i class="fas fa-bullseye" style={`color: ${toolkit.color};`} />
                <span>{toolkit.outcome}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ CHALLENGES SECTION ═══════════════════════════════════════ -->
  <section class="challenges-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-hand-holding-heart"></i> Where We Work
        </div>
        <h2>Addressing <span class="accent-red">Critical Challenges</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Our interventions are designed specifically for communities facing
          multiple, intersecting vulnerabilities.
        </p>
      </div>
      <div class="challenges-grid">
        {
          challenges.map((c) => (
            <a href={c.href} class="challenge-card" key={c.title}>
              <div class="challenge-icon">{c.icon}</div>
              <h3>{c.title}</h3>
              <p>{c.description}</p>
              <span class="challenge-link">
                Learn more <i class="fas fa-arrow-right" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ COMMUNITY VOICES ═══════════════════════════════════════ -->
  <section class="testimonials-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-quote-left"></i> Sample Community Voices
        </div>
        <h2>Stories of <span class="accent-green">Transformation</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Real impact from the communities we serve across Africa
        </p>
      </div>
      <div class="testimonials-grid">
        {
          testimonials.map((t) => (
            <div class="testimonial-card" key={t.name}>
              <div class="testi-quote-icon">
                <i class="fas fa-quote-left" />
              </div>
              <p class="testi-text">"{t.quote}"</p>
              <div class="testi-challenge">
                <span class="challenge-badge">{t.challenge}</span>
              </div>
              <div class="testi-author">
                <div class="testi-flag">{t.flag}</div>
                <div>
                  <div class="testi-name">{t.name}</div>
                  <div class="testi-role">
                    {t.role}, {t.location}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ DELIVERY MODES ═══════════════════════════════════════ -->
  <section class="modes-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-sliders-h"></i> How We Deliver
        </div>
        <h2>Flexible <span class="accent-red">Approaches</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          We adapt our delivery methods to meet communities where they are
        </p>
      </div>
      <div class="modes-grid">
        {
          deliveryModes.map((mode) => (
            <a href={mode.href} class="mode-card" key={mode.title}>
              <div class="mode-icon-big">
                <i class={mode.icon} />
              </div>
              <div class="mode-body">
                <h3>{mode.title}</h3>
                <p>{mode.description}</p>
                <span class="mode-link">
                  Learn more <i class="fas fa-arrow-right" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ BLOG / LATEST INSIGHTS ═══════════════════════════════════════ -->
  <section class="blog-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-newspaper"></i> Latest Insights
        </div>
        <h2>From the <span class="accent-red">Field</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Stories, research, and lessons from our work across Africa's most
          vulnerable communities.
        </p>
      </div>

      {
        blogPosts.length > 0 ? (
          <div class="blog-grid">
            {blogPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="blog-card" key={post.id}>
                <div class="blog-img-wrap">
                  <img
                    src={post.data.image || "/blog-placeholder.webp"}
                    alt={post.data.title}
                    loading="lazy"
                  />
                  <div class="blog-category">
                    <i class={post.data.categoryIcon || "fas fa-tag"} />{" "}
                    {post.data.category || "Story"}
                  </div>
                </div>
                <div class="blog-body">
                  <div class="blog-meta">
                    <span>
                      <i class="fas fa-calendar-alt" />{" "}
                      {formatDate(post.data.pubDate)}
                    </span>
                    <span>
                      <i class="fas fa-clock" />{" "}
                      {post.data.readTime || "5 min read"}
                    </span>
                  </div>
                  <h3 class="blog-title">{post.data.title}</h3>
                  <p class="blog-excerpt">
                    {(
                      post.data.description ||
                      post.data.excerpt ||
                      ""
                    ).substring(0, 130)}
                    ...
                  </p>
                  <div class="blog-footer">
                    <span class="blog-author">
                      <i class="fas fa-pen" />{" "}
                      {post.data.author || "ActionPath Editorial"}
                    </span>
                    <span class="blog-read-link">
                      Read more <i class="fas fa-arrow-right" />
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="blog-empty">
            <i class="fas fa-newspaper" />
            <p>Stories coming soon — check back shortly.</p>
          </div>
        )
      }

      <div class="section-cta-row">
        <a href="/blog" class="btn-outline-dark"
          ><i class="fas fa-newspaper"></i> View All Articles</a
        >
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ PARTNERS SECTION ═══════════════════════════════════════ -->
  <section class="partners-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-handshake"></i> Our Network
        </div>
        <h2>Trusted by <span class="accent-red">Global Partners</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Collaborating with leading organizations to amplify impact across
          Africa
        </p>
      </div>
      <div class="partner-grid">
        {
          partners.map((partner) => (
            <a
              href={partner.href}
              class="partner-card"
              key={partner.name}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={partner.logo}
                alt={partner.name}
                class="partner-logo-fullcolor"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
      <p class="partner-cta">
        <i class="fas fa-plus-circle"></i> Join us in building resilient communities
        <a href="/contact" class="partner-link">Become a partner →</a>
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ FINAL CTA ═══════════════════════════════════════ -->
  <section class="cta-section full-width">
    <div class="cta-inner">
      <div class="cta-text">
        <div class="section-eyebrow light">
          <i class="fas fa-bolt"></i> Take Action
        </div>
        <h2>Ready to <span class="cta-highlight">transform lives</span>?</h2>
        <p>
          Partner with us to build sustainable livelihoods and resilient
          communities across Africa.
        </p>
        <div class="cta-buttons">
          <a href="/contact" class="btn-primary btn-large"
            ><i class="fas fa-envelope"></i> Partner With Us</a
          >
          <a href="/impact-report" class="btn-outline-light btn-large"
            ><i class="fas fa-download"></i> Download Impact Report</a
          >
        </div>
      </div>
      <div class="cta-img-wrap">
        <img
          src="/programs-hero.webp"
          alt="Empowered community members"
          class="cta-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  :root {
    --red: #c0392b;
    --red-dark: #a93226;
    --red-soft: rgba(192, 57, 43, 0.1);
    --green: #27ee31;
    --green-dk: #1bc424;
    --green-lt: #27f731;
    --charcoal: #1e293b;
    --gray-dk: #334155;
    --gray-md: #5a6e8a;
    --gray-sf: #f5f7fa;
    --border: #e2e8f0;
    --white: #ffffff;
    --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 20px 35px rgba(0, 0, 0, 0.12);
    --shadow-xl: 0 30px 50px rgba(0, 0, 0, 0.15);
  }

  /* Smooth scrolling for the whole page */
  html {
    scroll-behavior: smooth;
  }

  .full-width {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .accent-red {
    color: var(--red);
  }
  .accent-green {
    color: var(--green-dk);
  }

  /* ══════════════════════════════════════════ HERO ══════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-gallery {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    will-change: opacity, clip-path;
    transition: opacity 0.8s ease;
  }
  .hero-slide.is-active {
    opacity: 1;
  }
  .hero-slide.is-incoming {
    opacity: 1;
    clip-path: inset(0 var(--wipe-right, 100%) 0 0);
    transition: clip-path 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero-wipe {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    clip-path: inset(0 0 0 100%);
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    transition:
      clip-path 1.1s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s;
  }
  .hero-wipe-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(39, 238, 49, 0.7) 30%,
      var(--green) 50%,
      rgba(39, 238, 49, 0.7) 70%,
      transparent 100%
    );
    box-shadow: 0 0 18px 6px rgba(39, 238, 49, 0.7);
    border-radius: 2px;
    transition:
      left 1.1s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.65) 0%,
      rgba(0, 0, 0, 0.25) 55%,
      rgba(0, 0, 0, 0.5) 100%
    );
    z-index: 1;
  }
  .premium-hero-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    padding: 2rem 5%;
    margin-left: 5%;
  }

  .hero-accent-badge {
    display: inline-block;
    background: rgba(39, 238, 49, 0.15);
    backdrop-filter: blur(8px);
    color: var(--green);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 0.4rem 1.2rem;
    border-radius: 40px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(39, 238, 49, 0.35);
    opacity: 0;
    animation: heroFadeUp 0.7s ease 0.1s forwards;
  }

  .hero-title {
    font-family: "Outfit", sans-serif;
    font-size: 5rem;
    font-weight: 900;
    line-height: 1.08;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }
  .hero-line {
    display: block;
    color: var(--green);
    text-shadow:
      0 2px 20px rgba(0, 0, 0, 0.4),
      0 0 40px rgba(39, 238, 49, 0.12);
    opacity: 0;
    transform: translateY(32px) skewX(-3deg);
    animation: heroLineIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .hero-line-green {
    background: linear-gradient(
      135deg,
      var(--green) 0%,
      #6eff6e 60%,
      var(--green-lt) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 0 20px rgba(39, 238, 49, 0.3));
  }
  .hero-line-1 {
    animation-delay: 0.15s;
  }
  .hero-line-2 {
    animation-delay: 0.38s;
  }
  .hero-line-3 {
    animation-delay: 0.62s;
  }

  @keyframes heroLineIn {
    0% {
      opacity: 0;
      transform: translateY(32px) skewX(-3deg);
    }
    60% {
      opacity: 1;
      transform: translateY(-4px) skewX(0.5deg);
    }
    80% {
      transform: translateY(3px) skewX(-0.3deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) skewX(0);
    }
  }
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-desc {
    font-size: 1.08rem;
    color: rgba(255, 255, 255, 0.92);
    max-width: 580px;
    margin-bottom: 2rem;
    line-height: 1.75;
    opacity: 0;
    animation: heroFadeUp 0.7s ease 0.85s forwards;
  }
  .hero-buttons {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: heroFadeUp 0.7s ease 1.1s forwards;
  }
  .btn-premium {
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    padding: 1rem 2.2rem;
    font-size: 1rem;
    box-shadow: 0 4px 18px rgba(192, 57, 43, 0.35);
    transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  }
  .btn-premium:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(192, 57, 43, 0.45);
  }
  .btn-outline-premium {
    border: 2px solid var(--green);
    color: var(--green);
    padding: 1rem 2.2rem;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(39, 238, 49, 0.07);
    text-decoration: none;
    backdrop-filter: blur(4px);
  }
  .btn-outline-premium:hover {
    background: var(--green);
    color: var(--charcoal);
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(39, 238, 49, 0.3);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    animation: scrollBounce 2.5s ease-in-out infinite;
  }
  .hero-scroll-indicator i {
    font-size: 0.8rem;
  }
  @keyframes scrollBounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
      opacity: 0.55;
    }
    50% {
      transform: translateX(-50%) translateY(9px);
      opacity: 1;
    }
  }

  /* ══════════════════════════════════════════ STATS ══════════════════════════════════════════ */
  .stats-strip {
    background: linear-gradient(135deg, var(--charcoal) 0%, #2d3748 100%);
    padding: 3rem 0;
  }
  .stats-container {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .stat-item {
    text-align: center;
    color: white;
    flex: 1;
    min-width: 180px;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUpStat 0.6s ease forwards;
    animation-delay: 0.2s;
  }
  @keyframes fadeUpStat {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .stat-item i {
    font-size: 2.2rem;
    color: var(--green-lt);
    margin-bottom: 0.5rem;
    display: block;
  }
  .stat-number {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: white;
    margin-bottom: 0.25rem;
  }
  .stat-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ═══════════════════════════════════════ PITCHING DEMO SECTION (NEW) ═══════════════════════════════════════ */
  .pitching-demo-section {
    padding: 5rem 0;
    background: linear-gradient(135deg, #fff 0%, var(--gray-sf) 100%);
    position: relative;
    overflow: hidden;
  }
  .pitching-demo-container {
    display: flex;
    align-items: center;
    gap: 4rem;
    background: var(--white);
    border-radius: 32px;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border);
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }
  .pitching-demo-container:hover {
    transform: translateY(-6px);
    box-shadow: 0 35px 55px rgba(0, 0, 0, 0.12);
  }
  .pitching-demo-content {
    flex: 1;
    padding: 3rem;
  }
  .demo-eyebrow {
    background: var(--red-soft);
    color: var(--red);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.4rem 1.2rem;
    border-radius: 40px;
    margin-bottom: 1rem;
  }
  .pitching-demo-content h2 {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--charcoal);
    margin-bottom: 1rem;
  }
  .pitching-demo-content p {
    color: var(--gray-md);
    line-height: 1.7;
    margin-bottom: 2rem;
    font-size: 1rem;
  }
  .pitching-demo-image {
    flex: 1;
    position: relative;
    min-height: 380px;
    overflow: hidden;
    cursor: pointer;
  }
  .pitching-demo-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    display: block;
  }
  .pitching-demo-container:hover .pitching-demo-image img {
    transform: scale(1.05);
  }
  .image-overlay-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(39, 238, 49, 0.15) 0%,
      transparent 70%
    );
    opacity: 0;
