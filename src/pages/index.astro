<script>
  // ── Smooth scroll for anchor links ──────────────────────────────────
  (function () {
    const smoothScrollLinks = document.querySelectorAll(
      '.smooth-scroll, a[href^="#"]',
    );
    smoothScrollLinks.forEach((link) => {
      link.addEventListener("click", function (e) {
        const href = this.getAttribute("href");
        if (href && href.startsWith("#")) {
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      });
    });
  })();

  // ── Hero wipe transition ──────────────────────────────────────────────
  (function () {
    const HOLD_MS = 5000;
    const WIPE_MS = 1100;
    function ease(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;
    }

    const gallery = document.getElementById("heroGallery");
    const wipe = document.getElementById("heroWipe");
    const edge = document.getElementById("heroWipeEdge");
    const slides = Array.from(
      gallery ? gallery.querySelectorAll(".hero-slide") : [],
    );
    if (!slides.length || !wipe || !edge) return;

    let current = 0,
      animating = false;

    function schedule() {
      setTimeout(runWipe, HOLD_MS);
    }

    function runWipe() {
      if (animating) return;
      animating = true;
      const out = slides[current];
      const next = (current + 1) % slides.length;
      const inn = slides[next];
      inn.style.setProperty("--wipe-right", "100%");
      inn.classList.add("is-incoming");
      wipe.style.transition = "none";
      wipe.style.clipPath = "inset(0 0 0 100%)";
      wipe.style.opacity = "1";
      edge.style.transition = "none";
      edge.style.left = "100%";
      edge.style.opacity = "1";

      let t0 = null;
      function step(ts) {
        if (!t0) t0 = ts;
        const raw = Math.min((ts - t0) / WIPE_MS, 1);
        const p = ease(raw);
        const openLeft = (1 - p) * 100;
        wipe.style.clipPath = `inset(0 0 0 ${openLeft}%)`;
        inn.style.setProperty("--wipe-right", `${openLeft}%`);
        edge.style.left = `calc(${openLeft}% - 2px)`;
        if (raw < 1) {
          requestAnimationFrame(step);
          return;
        }
        out.classList.remove("is-active");
        inn.classList.remove("is-incoming");
        inn.classList.add("is-active");
        inn.style.removeProperty("--wipe-right");
        wipe.style.transition = "opacity 0.2s";
        wipe.style.opacity = "0";
        edge.style.transition = "opacity 0.2s";
        edge.style.opacity = "0";
        setTimeout(() => {
          wipe.style.transition = "none";
          wipe.style.clipPath = "inset(0 0 0 100%)";
          edge.style.transition = "none";
        }, 250);
        current = next;
        animating = false;
        schedule();
      }
      requestAnimationFrame(step);
    }

    slides[current].classList.add("is-active");
    schedule();
  })();

  // ── Counting statistics ───────────────────────────────────────────────
  (function () {
    const counters = document.querySelectorAll(".stat-count");
    if (!counters.length) return;
    const animate = (el, target, suffix, prefix) => {
      let cur = 0,
        inc = target / 60;
      const t = setInterval(() => {
        cur += inc;
        if (cur >= target) {
          el.textContent = prefix + Math.round(target) + suffix;
          clearInterval(t);
        } else {
          el.textContent = prefix + Math.floor(cur) + suffix;
        }
      }, 20);
    };
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target;
          animate(
            el,
            +el.dataset.target,
            el.dataset.suffix || "",
            el.dataset.prefix || "",
          );
          obs.unobserve(el);
        });
      },
      { threshold: 0.5 },
    );
    counters.forEach((c) => obs.observe(c));
  })();

  // ── Play badge hover effect on pitching demo ──────────────────────────
  (function () {
    const demoImg = document.querySelector(".pitching-demo-image");
    const playBadge = document.querySelector(".play-badge");
    if (demoImg && playBadge) {
      demoImg.addEventListener("click", () => {
        // Optional: open a video modal or redirect to impact page
        window.location.href = "/impact";
      });
    }
  })();
</script>


