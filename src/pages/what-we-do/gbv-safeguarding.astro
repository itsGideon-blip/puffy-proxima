---
// what-we-do/gbv-safeguarding.astro - GBV & Safeguarding
import Layout from "../../layouts/Layout.astro";

const pillars = [
  {
    icon: "fas fa-shield-halved",
    title: "A robust safeguarding policy",
    lead: "A clear policy sets out what is expected of everyone who works with or for ActionPath Africa.",
    points: [
      "A code of conduct for staff, trainers, volunteers, and partners",
      "Safe recruitment and onboarding of people who work with participants",
      "Clear reporting channels, with zero tolerance for abuse, exploitation, and harassment",
    ],
  },
  {
    icon: "fas fa-hand-holding-heart",
    title: "Survivor-centered response pathways",
    lead: "When something happens, the survivor's safety, dignity, and choices come first.",
    points: [
      "A respectful, non-judgemental response that protects privacy",
      "Referral to health, psychosocial, and legal support",
      "Follow-up guided by what the survivor wants",
    ],
  },
  {
    icon: "fas fa-handshake",
    title: "Strategic partnerships",
    lead: "No single organization can respond to GBV alone, so we work with those who specialize in it.",
    points: [
      "Specialist GBV service providers and legal aid organizations",
      "Community-based organizations and local leaders",
      "Government and development partners",
    ],
  },
  {
    icon: "fas fa-universal-access",
    title: "Disability-inclusive design",
    lead: "Persons with disabilities face higher risks of abuse and exploitation, so safeguarding has to be accessible.",
    points: [
      "Reporting channels in accessible formats",
      "Training venues and schedules that are safe and accessible",
      "Work with organizations of persons with disabilities",
    ],
  },
];
---

<Layout
  title="GBV & Safeguarding | ActionPath Africa"
  description="How ActionPath Africa builds safeguarding and GBV prevention into every livelihood program: a robust policy, survivor-centered response, partnerships, and disability-inclusive design."
>
  <div class="pg">
    <!-- HERO -->
    <section class="hero">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <a href="/what-we-do">What We Do</a>
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
        <span>GBV &amp; Safeguarding</span>
      </nav>
      <h1>Safeguarding and GBV prevention in every program we deliver</h1>
      <p class="hero-lead">
        We make safeguarding and GBV prevention an integral part of every
        livelihood program, so the people we train are safe while they learn
        and earn.
      </p>
    </section>

    <!-- PILLARS -->
    <section class="pillars-section">
      <div class="section-head">
        <h2>Four things we combine to keep people safe</h2>
        <div class="rule"></div>
        <p>
          Each one supports the others. A policy is only as strong as the
          response behind it, and a response is only as good as the partners
          and accessibility around it.
        </p>
      </div>
      <div class="pillars">
        {
          pillars.map((p) => (
            <article class="pillar">
              <header class="pillar-head">
                <span class="pillar-icon">
                  <i class={p.icon} aria-hidden="true" />
                </span>
                <h3>{p.title}</h3>
              </header>
              <p class="pillar-lead">{p.lead}</p>
              <ul>
                {p.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- BUILT IN + REPORT -->
    <section class="split">
      <div class="split-text">
        <h2>Prevention is part of the training, not an add-on</h2>
        <div class="rule"></div>
        <p>
          GBV awareness and gender inclusion run alongside our livelihood
          modules, so participants and trainers learn what safe, respectful
          practice looks like.
        </p>
        <ul class="links">
          <li>
            <a href="/what-we-do/training/gender-inclusion">
              Gender &amp; Social Inclusion training
            </a>
          </li>
          <li>
            <a href="/what-we-do/training/sgbv">SGBV training</a>
          </li>
          <li>
            <a href="/what-we-do/disability-inclusion">
              Disability inclusion
            </a>
          </li>
        </ul>
      </div>

      <aside class="concern" aria-labelledby="concern-title">
        <h3 id="concern-title">Raise a safeguarding concern</h3>
        <p>
          If you have a concern or want to report an incident, write to us at
          <a href="mailto:info@actionpathafrica.org"
            >info@actionpathafrica.org</a
          >
          or use our contact page. We take every report seriously and put the
          survivor's safety and choices first.
        </p>
        <a href="/contact" class="btn btn-primary">
          <i class="fas fa-envelope" aria-hidden="true"></i> Contact us
        </a>
      </aside>
    </section>

    <!-- BAND -->
    <section class="band">
      <p class="band-quote">
        Our training does not just build livelihoods. It builds safety,
        dignity, and justice for the people we serve.
      </p>
      <a href="/contact" class="btn btn-light">Partner with us</a>
    </section>
  </div>
</Layout>

<style>
  .pg {
    --red: #c0392b;
    --red-dark: #a93226;
    --red-soft: rgba(192, 57, 43, 0.1);
    --green-mid: #1a8c1f;
    --green-soft: rgba(39, 238, 49, 0.12);
    --ink: #1e293b;
    --ink-2: #334155;
    --muted: #64748b;
    --line: #e2e8f0;
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    width: 100%;
  }

  .pg a:focus-visible {
    outline: 3px solid var(--green-mid);
    outline-offset: 3px;
  }

  /* Hero */
  .hero {
    position: relative;
    background: var(--ink);
    color: white;
    border-radius: 24px;
    border-bottom: 4px solid var(--red);
    padding: 3.5rem 3rem 3.25rem;
    margin-bottom: 3.5rem;
    overflow: hidden;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 85% 40%,
      rgba(192, 57, 43, 0.2) 0%,
      transparent 60%
    );
    pointer-events: none;
  }
  .hero > * {
    position: relative;
    z-index: 1;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1.5rem;
  }
  .crumbs a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #27f731;
  }
  .crumbs i {
    font-size: 0.55rem;
  }
  .hero h1 {
    font-family: "Outfit", sans-serif;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 760px;
    margin-bottom: 1.1rem;
  }
  .hero-lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
    max-width: 580px;
  }

  /* Shared headings */
  .rule {
    width: 56px;
    height: 3px;
    background: linear-gradient(90deg, var(--red), #27ee31);
    border-radius: 3px;
    margin: 0.9rem 0 1.25rem;
  }
  .pg h2 {
    font-family: "Outfit", sans-serif;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  /* Pillars */
  .pillars-section {
    margin-bottom: 4.5rem;
  }
  .section-head {
    max-width: 640px;
    margin-bottom: 2.5rem;
  }
  .section-head p {
    color: var(--muted);
    line-height: 1.8;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.75rem 3.5rem;
  }
  .pillar {
    border-left: 4px solid var(--red);
    padding-left: 1.5rem;
  }
  .pillar:nth-child(even) {
    border-left-color: var(--green-mid);
  }
  .pillar-head {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    margin-bottom: 0.9rem;
  }
  .pillar-icon {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--red-soft);
    color: var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pillar:nth-child(even) .pillar-icon {
    background: var(--green-soft);
    color: var(--green-mid);
  }
  .pillar-head h3 {
    font-family: "Outfit", sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--ink);
  }
  .pillar-lead {
    font-weight: 600;
    color: var(--ink);
    line-height: 1.6;
    margin-bottom: 0.9rem;
  }
  .pillar ul {
    list-style: none;
  }
  .pillar li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.55rem;
    color: var(--ink-2);
    font-size: 0.93rem;
    line-height: 1.7;
  }
  .pillar li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
  }
  .pillar:nth-child(even) li::before {
    background: var(--green-mid);
  }

  /* Split */
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: start;
    margin-bottom: 4rem;
  }
  .split-text p {
    color: var(--muted);
    line-height: 1.8;
    max-width: 58ch;
    margin-bottom: 1.25rem;
  }
  .links {
    list-style: none;
    border-top: 1px solid var(--line);
    max-width: 440px;
  }
  .links li {
    border-bottom: 1px solid var(--line);
  }
  .links a {
    display: block;
    padding: 0.8rem 0;
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--red);
  }

  .concern {
    background: var(--red-soft);
    border-left: 4px solid var(--red);
    border-radius: 0 20px 20px 0;
    padding: 1.75rem 1.75rem 1.9rem;
  }
  .concern h3 {
    font-family: "Outfit", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .concern p {
    color: var(--ink-2);
    line-height: 1.75;
    font-size: 0.93rem;
    margin-bottom: 1.25rem;
  }
  .concern p a {
    color: var(--red-dark);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  /* Band + buttons */
  .band {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2.5rem;
    background: var(--ink);
    color: white;
    border-radius: 28px;
    padding: 3rem 3.25rem;
    margin-bottom: 2rem;
  }
  .band-quote {
    font-family: "Outfit", sans-serif;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 34ch;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.75rem 1.75rem;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn-primary {
    background: var(--red);
    color: white;
  }
  .btn-primary:hover {
    background: var(--red-dark);
  }
  .btn-light {
    flex: none;
    border: 2px solid rgba(255, 255, 255, 0.35);
    color: white;
  }
  .btn-light:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .pg {
      padding: 1rem;
    }
    .hero {
      padding: 2.5rem 1.5rem;
    }
    .pillars {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .split {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .band {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.25rem 1.75rem;
    }
  }
</style>
