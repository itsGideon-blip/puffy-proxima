---
import Layout from "../../../layouts/Layout.astro";
const pageTitle = "Report Writing Training | ActionPath Africa";
const pageDescription = "ActionPath Africa's Report Writing training equips participants with the skills to document, communicate, and present their work clearly and professionally.";
---
<Layout title={pageTitle} description={pageDescription}>
  <main>
    <section class="cluster-hero">
      <div class="cluster-hero-inner">
        <div class="cluster-breadcrumb">
          <a href="/">Home</a> <i class="fas fa-chevron-right"></i>
          <a href="/what-we-do/training">Training</a> <i class="fas fa-chevron-right"></i>
          <span>Report Writing</span>
        </div>
        <div class="cluster-icon-large"><i class="fas fa-file-alt"></i></div>
        <h1 class="all-red">Report Writing</h1>
        <p class="cluster-subhead">At ActionPath Africa, we equip participants with the skills to write clear, compelling, and professional reports that communicate impact, inform decisions, and satisfy donor and stakeholder requirements.</p>
        <div class="cluster-ctas">
          <a href="/contact" class="btn-primary"><i class="fas fa-envelope"></i> Inquire About Training</a>
          <a href="/what-we-do/training" class="btn-outline"><i class="fas fa-arrow-left"></i> All Training</a>
        </div>
      </div>
    </section>
    <section class="cluster-focus">
      <div class="cluster-container">
        <div class="section-header">
          <div class="section-eyebrow"><i class="fas fa-bullseye"></i> What We Focus On</div>
          <h2>Training <span class="accent-red">Topics</span></h2>
          <div class="section-divider"></div>
        </div>
        <div class="focus-grid">
          <div class="focus-item">Purpose & Types of Reports</div>
          <div class="focus-item">Understanding Your Audience</div>
          <div class="focus-item">Report Structure & Formatting</div>
          <div class="focus-item">Executive Summaries & Introductions</div>
          <div class="focus-item">Data Presentation & Visualization</div>
          <div class="focus-item">Writing Findings & Recommendations</div>
          <div class="focus-item">Donor & Funder Report Requirements</div>
          <div class="focus-item">Progress & Activity Reports</div>
          <div class="focus-item">M&E Reports & Impact Documentation</div>
          <div class="focus-item">Proofreading & Editing Techniques</div>
          <div class="focus-item">Using Plain Language & Avoiding Jargon</div>
          <div class="focus-item">Digital Tools for Report Writing</div>
        </div>
        <div class="focus-cta">
          <a href="/contact" class="btn-primary"><i class="fas fa-calendar-alt"></i> Book a Training Session</a>
        </div>
      </div>
    </section>
    <section class="cluster-related">
      <div class="cluster-container">
        <div class="related-grid">
          <div class="related-card">
            <i class="fas fa-comments"></i>
            <h3>Effective Communication</h3>
            <p>Build strong verbal and written communication skills.</p>
            <a href="/what-we-do/training/communication">Learn more →</a>
          </div>
          <div class="related-card">
            <i class="fas fa-file-signature"></i>
            <h3>Grants & Proposal Writing</h3>
            <p>Write winning proposals for funders and donors.</p>
            <a href="/what-we-do/training/proposal-writing">Learn more →</a>
          </div>
          <div class="related-card">
            <i class="fas fa-chart-line"></i>
            <h3>Monitoring & Evaluation</h3>
            <p>Track and document your program's impact effectively.</p>
            <a href="/what-we-do/training/documentation">Learn more →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
<style is:global>
  .cluster-hero { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 4rem 0; color: white; }
  .cluster-hero-inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .cluster-breadcrumb { font-size: 0.8rem; color: rgba(255,255,255,0.6); margin-bottom: 2rem; }
  .cluster-breadcrumb a { color: var(--green-lt); text-decoration: none; }
  .cluster-breadcrumb i { font-size: 0.7rem; margin: 0 0.5rem; }
  .cluster-icon-large { font-size: 4rem; color: var(--green); margin-bottom: 1rem; }
  .cluster-hero h1 { font-size: 3rem; font-weight: 800; margin-bottom: 1rem; }
  .all-red { color: var(--red); }
  .accent-red { color: var(--red); }
  .cluster-subhead { font-size: 1.1rem; color: rgba(255,255,255,0.85); max-width: 900px; margin-bottom: 2rem; line-height: 1.5; }
  .cluster-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary { background: linear-gradient(135deg, var(--red), var(--red-dark)); color: white; padding: 0.85rem 2rem; border-radius: 50px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(192, 57, 43, 0.4); }
  .btn-outline { border: 2px solid rgba(255,255,255,0.3); background: transparent; color: white; padding: 0.85rem 2rem; border-radius: 50px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; }
  .btn-outline:hover { border-color: var(--green); background: rgba(39,238,49,0.1); }
  .cluster-container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .section-header { text-align: center; margin-bottom: 2.5rem; }
  .section-eyebrow { display: inline-flex; align-items: center; gap: 8px; background: var(--red-soft); color: var(--red); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0.4rem 1.3rem; border-radius: 40px; margin-bottom: 1rem; }
  .section-header h2 { font-size: 2rem; font-weight: 800; color: var(--charcoal); }
  .section-divider { width: 70px; height: 4px; background: linear-gradient(90deg, var(--red), var(--green)); margin: 1rem auto 0; border-radius: 2px; }
  .cluster-focus { padding: 4rem 0; background: white; }
  .focus-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2rem; }
  .focus-item { background: var(--gray-sf); padding: 1rem 1.25rem; border-radius: 12px; font-weight: 500; color: var(--charcoal); border-left: 3px solid var(--red); }
  .focus-cta { text-align: center; margin-top: 1rem; }
  .cluster-related { padding: 3rem 0 5rem; background: var(--gray-sf); }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; max-width: 900px; margin: 0 auto; }
  .related-card { background: white; padding: 1.5rem; border-radius: 20px; text-align: center; border: 1px solid var(--border); }
  .related-card i { font-size: 2rem; color: var(--green); margin-bottom: 0.75rem; }
  .related-card h3 { font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--charcoal); }
  .related-card p { font-size: 0.8rem; color: var(--gray-md); margin-bottom: 1rem; }
  .related-card a { color: var(--red); font-weight: 600; text-decoration: none; font-size: 0.85rem; }
  .related-card a:hover { text-decoration: underline; }
  @media (max-width: 768px) { .focus-grid { grid-template-columns: 1fr; } .related-grid { grid-template-columns: 1fr; } .cluster-hero h1 { font-size: 2rem; } .section-header h2 { font-size: 1.5rem; } }
</style>
