---
// about.astro - ActionPath Africa About Page
import Layout from "../layouts/Layout.astro";

// Partners data (duplicated from homepage)
const partners = [
  {
    name: "ActionAid",
    logo: "/logos/actionaid.png",
    href: "https://www.actionaid.org",
  },
  {
    name: "Kenya Government",
    logo: "/logos/kenya-government.png",
    href: "https://www.kenya.go.ke",
  },
  { name: "UNHCR", logo: "/logos/unhcr.png", href: "https://www.unhcr.org" },
  {
    name: "Mercy Corps",
    logo: "/logos/mercy-corps.png",
    href: "https://www.mercycorps.org",
  },
  {
    name: "Safaricom Foundation",
    logo: "/logos/safaricom-foundation.png",
    href: "https://www.safaricomfoundation.org",
  },
  { name: "TVETA", logo: "/logos/tveta.png", href: "https://www.tveta.go.ke" },
  {
    name: "VSO International",
    logo: "/logos/vso.png",
    href: "https://www.vsointernational.org",
  },
  {
    name: "Challenge Fund for Youth Employment",
    logo: "/logos/cfye.png",
    href: "https://www.fundforyouthemployment.nl",
  },
  {
    name: "Tanzania Ministry of Education",
    logo: "/logos/tanzania-moe.png",
    href: "https://www.moe.go.tz",
  },
  {
    name: "Ace Africa",
    logo: "/logos/ace-africa.png",
    href: "https://www.ace-africa.org",
  },
  {
    name: "East Africa Civil Societies Forum",
    logo: "/logos/eacso.png",
    href: "https://www.eacsof.net",
  },
];
---

<Layout
  title="About Us | ActionPath Africa"
  description="ActionPath Africa is a Pan-African livelihood training and consultancy organisation empowering communities through practical skills, integrity, and inclusivity."
>
  <!-- ═══════════════════════════════════════ HERO ═══════════════════════════════════════ -->
  <section class="about-hero full-width">
    <div class="about-hero-bg">
      <img src="/about-hero.webp" alt="Community empowerment" loading="lazy" />
      <div class="about-hero-overlay"></div>
    </div>
    <div class="section-inner about-hero-content">
      <div class="section-eyebrow light">
        <i class="fas fa-info-circle"></i> Who We Are
      </div>
      <h1>About <span class="accent-red">ActionPath Africa</span></h1>
      <div class="section-divider left"></div>
      <p class="about-hero-desc">
        Empowering communities through sustainable livelihoods, practical
        skills, and unwavering integrity.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ OUR STORY ═══════════════════════════════════════ -->
  <section class="story-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-book-open"></i> Our Story
        </div>
        <h2>
          More than training — <span class="accent-red"
            >a movement for change</span
          >
        </h2>
        <div class="section-divider"></div>
      </div>
      <div class="story-grid">
        <div class="story-text">
          <p class="story-lead">
            At ActionPath Africa, we design and deliver transformative
            livelihood training programs that equip youth, women, and
            marginalized communities with practical skills, entrepreneurial
            confidence, and the psychosocial resilience to break cycles of
            poverty.
          </p>
          <p>
            Our approach is holistic and context-specific. Every program is
            built in partnership with communities and aligned to national
            development strategies, the SDGs, and Africa's Agenda 2063, ensuring
            impact that outlasts donor cycles and builds genuinely
            self-sustaining livelihoods.
          </p>
          <div class="story-highlight">
            <span class="story-stat">15,000+</span>
            <span class="story-stat-label">lives transformed</span>
          </div>
        </div>
        <div class="story-bullets">
          <div class="story-bullet">
            <i class="fas fa-users"></i>
            <span>Community-owned, market-linked livelihood programs</span>
          </div>
          <div class="story-bullet">
            <i class="fas fa-certificate"></i>
            <span
              >Accredited training aligned to national qualifications frameworks</span
            >
          </div>
          <div class="story-bullet">
            <i class="fas fa-heart"></i>
            <span>Psychosocial support integrated into all programs</span>
          </div>
          <div class="story-bullet">
            <i class="fas fa-venus-mars"></i>
            <span>Gender-responsive and youth-inclusive by design</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ OUR IMPACT (additional context) ═══════════════════════════════════════ -->
  <section class="impact-description full-width">
    <div class="section-inner">
      <div class="impact-block">
        <p>
          ActionPath Africa is a Pan-African livelihood training, consultancy,
          and capacity building organisation committed to transforming the
          trajectories of communities living at the intersection of poverty,
          climate vulnerability, conflict, and disease.
        </p>
        <p>
          We work where others struggle to — in post-conflict zones,
          drought-stricken landscapes, urban slums, and HIV-affected households
          — delivering practical, context-specific programs that give
          individuals not just skills, but agency, dignity, and economic
          pathways.
        </p>
        <p>
          Our model is built on three pillars: rigorous curriculum design,
          participatory community engagement, and sustainable institutional
          partnerships. Together these pillars ensure our programs outlast donor
          funding, embed within local systems, and create ripple effects across
          entire communities.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ MISSION & VISION ═══════════════════════════════════════ -->
  <section class="mission-vision-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-bullseye"></i> Our Compass
        </div>
        <h2>Mission &amp; <span class="accent-green">Vision</span></h2>
        <div class="section-divider"></div>
      </div>
      <div class="mv-grid">
        <div class="mv-card mission">
          <div class="mv-icon"><i class="fas fa-flag"></i></div>
          <h3>Our Mission</h3>
          <p>
            To empower individuals with practical skills and knowledge that
            foster sustainable livelihoods, uphold integrity in every
            engagement, and champion inclusivity by creating opportunities for
            all, especially marginalized communities.
          </p>
        </div>
        <div class="mv-card vision">
          <div class="mv-icon"><i class="fas fa-eye"></i></div>
          <h3>Our Vision</h3>
          <p>
            To be a leading consultancy that transforms lives by building
            resilient, self-reliant communities where empowerment, integrity,
            and inclusivity drive lasting social and economic progress.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ CORE VALUES ═══════════════════════════════════════ -->
  <section class="values-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-gem"></i> What We Stand For
        </div>
        <h2>Our <span class="accent-red">Core Values</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          The principles that guide our work and define our commitment to
          communities
        </p>
      </div>
      <div class="values-grid">
        <!-- Empowerment -->
        <div class="value-card">
          <div
            class="value-icon"
            style="color: var(--green-dk); background: rgba(39,238,49,0.12);"
          >
            <i class="fas fa-rocket"></i>
          </div>
          <h3>Empowerment</h3>
          <p>
            We focus on equipping trainees with practical skills, confidence,
            and self-reliance so they can sustainably improve their livelihoods.
            This means our work has a lasting impact beyond training.
          </p>
        </div>
        <!-- Integrity -->
        <div class="value-card">
          <div
            class="value-icon"
            style="color: var(--red); background: var(--red-soft);"
          >
            <i class="fas fa-shield-alt"></i>
          </div>
          <h3>Integrity</h3>
          <p>
            We uphold honesty, transparency, and ethical practices in all
            engagements. This means we build trust with trainees, partners, and
            communities, ensuring our work is credible and dependable.
          </p>
        </div>
        <!-- Inclusivity -->
        <div class="value-card">
          <div
            class="value-icon"
            style="color: #9b59b6; background: rgba(155,89,182,0.12);"
          >
            <i class="fas fa-hand-holding-heart"></i>
          </div>
          <h3>Inclusivity</h3>
          <p>
            We design and deliver training programs that are accessible to
            diverse groups, including marginalized communities, women, and
            youth. This ensures equal opportunity and broadens the reach of our
            impact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ TEAM LINK ═══════════════════════════════════════ -->
  <section class="team-cta-section full-width">
    <div class="section-inner">
      <div class="team-cta-container">
        <div class="team-cta-text">
          <h2>Meet Our <span class="accent-red">Dedicated Team</span></h2>
          <p>
            Passionate professionals committed to driving change and empowering
            communities across Africa.
          </p>
          <a href="/about/team" class="btn-primary"
            ><i class="fas fa-users"></i> View the Team</a
          >
        </div>
        <div class="team-cta-image">
          <img
            src="/about-cta-bg.webp"
            alt="ActionPath Africa team"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ PARTNERS (duplicated from homepage) ═══════════════════════════════════════ -->
  <section class="partners-section full-width">
    <div class="section-inner">
      <div class="section-header">
        <div class="section-eyebrow">
          <i class="fas fa-handshake"></i> Our Network
        </div>
        <h2>Trusted by <span class="accent-red">Global Partners</span></h2>
        <div class="section-divider"></div>
        <p class="section-subtitle">
          Collaborating with leading organizations to amplify impact across
          Africa
        </p>
      </div>
      <div class="partner-grid">
        {
          partners.map((partner) => (
            <a
              href={partner.href}
              class="partner-card"
              key={partner.name}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={partner.logo}
                alt={partner.name}
                class="partner-logo-fullcolor"
                loading="lazy"
              />
            </a>
          ))
        }
      </div>
      <p class="partner-cta">
        <i class="fas fa-plus-circle"></i> Join us in building resilient communities
        <a href="/contact" class="partner-link">Become a partner →</a>
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ FINAL CTA ═══════════════════════════════════════ -->
  <section class="cta-section full-width">
    <div class="cta-inner">
      <div class="cta-text">
        <div class="section-eyebrow light">
          <i class="fas fa-bolt"></i> Take Action
        </div>
        <h2>Ready to <span class="cta-highlight">transform lives</span>?</h2>
        <p>
          Partner with us to build sustainable livelihoods and resilient
          communities across Africa.
        </p>
        <div class="cta-buttons">
          <a href="/contact" class="btn-primary btn-large"
            ><i class="fas fa-envelope"></i> Partner With Us</a
          >
          <a href="/impact-report" class="btn-outline-light btn-large"
            ><i class="fas fa-download"></i> Download Impact Report</a
          >
        </div>
      </div>
      <div class="cta-img-wrap">
        <img
          src="/programs-hero.webp"
          alt="Empowered community members"
          class="cta-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* ── reused variables and base styles from homepage ── */
  :root {
    --red: #c0392b;
    --red-dark: #a93226;
    --red-soft: rgba(192, 57, 43, 0.1);
    --green: #27ee31;
    --green-dk: #1bc424;
    --green-lt: #27f731;
    --charcoal: #1e293b;
    --gray-dk: #334155;
    --gray-md: #5a6e8a;
    --gray-sf: #f5f7fa;
    --border: #e2e8f0;
    --white: #ffffff;
    --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 20px 35px rgba(0, 0, 0, 0.12);
    --shadow-xl: 0 30px 50px rgba(0, 0, 0, 0.15);
  }

  .full-width {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .accent-red {
    color: var(--red);
  }
  .accent-green {
    color: var(--green-dk);
  }

  /* Shared button & eyebrow styles (copied from homepage) */
  .btn-primary {
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    color: white;
    padding: 0.85rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(192, 57, 43, 0.4);
  }

  .btn-outline-dark {
    border: 2px solid var(--charcoal);
    color: var(--charcoal);
    padding: 0.85rem 2rem;
    border-radius: 50px;
    font-weight: 700;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    text-decoration: none;
  }
  .btn-outline-dark:hover {
    background: var(--charcoal);
    color: white;
    transform: translateY(-2px);
  }

  .btn-outline-light {
    border: 2px solid rgba(255, 255, 255, 0.4);
    color: white;
    padding: 0.9rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    text-decoration: none;
  }
  .btn-outline-light:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
    transform: translateY(-3px);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--red-soft);
    color: var(--red);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 1.3rem;
    border-radius: 40px;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
  }
  .section-eyebrow.light {
    background: rgba(255, 255, 255, 0.15);
    color: var(--green-lt);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .section-header h2 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--charcoal);
  }
  .section-divider {
    width: 70px;
    height: 4px;
    background: linear-gradient(90deg, var(--red), var(--green));
    margin: 1rem auto 1.5rem;
    border-radius: 2px;
  }
  .section-divider.left {
    margin: 0.75rem 0 1.5rem;
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--red), var(--green));
    border-radius: 2px;
  }

  .section-subtitle {
    color: var(--gray-md);
    font-size: 1rem;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── ABOUT HERO ── */
  .about-hero {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--charcoal);
  }
  .about-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .about-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.3) 80%
    );
    z-index: 1;
  }
  .about-hero-content {
    position: relative;
    z-index: 2;
    padding: 4rem 2rem;
    color: white;
  }
  .about-hero-content h1 {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .about-hero-desc {
    font-size: 1.1rem;
    max-width: 600px;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
  }

  /* ── STORY SECTION ── */
  .story-section {
    padding: 5rem 0;
    background: var(--gray-sf);
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .story-lead {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--red);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .story-text p {
    color: var(--gray-dk);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
  .story-highlight {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    background: white;
    padding: 1rem 2rem;
    border-radius: 60px;
    box-shadow: var(--shadow-sm);
    border-left: 4px solid var(--green);
  }
  .story-stat {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--red);
    letter-spacing: -0.02em;
  }
  .story-stat-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--gray-dk);
  }

  .story-bullets {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .story-bullet {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: white;
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .story-bullet:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .story-bullet i {
    font-size: 1.5rem;
    color: var(--green-dk);
    margin-top: 0.1rem;
    width: 2rem;
    text-align: center;
  }
  .story-bullet span {
    font-size: 0.95rem;
    color: var(--charcoal);
    font-weight: 500;
  }

  /* ── IMPACT DESCRIPTION ── */
  .impact-description {
    padding: 4rem 0;
    background: white;
  }
  .impact-block {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .impact-block p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--gray-dk);
    margin-bottom: 1.5rem;
  }
  .impact-block p:last-child {
    margin-bottom: 0;
  }

  /* ── MISSION & VISION ── */
  .mission-vision-section {
    padding: 5rem 0;
    background: var(--gray-sf);
  }
  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .mv-card {
    background: white;
    border-radius: 28px;
    padding: 2.5rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .mv-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .mv-icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    font-size: 2rem;
    background: var(--red-soft);
    color: var(--red);
  }
  .mv-card.vision .mv-icon {
    background: rgba(39, 238, 49, 0.12);
    color: var(--green-dk);
  }
  .mv-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--charcoal);
    margin-bottom: 0.75rem;
  }
  .mv-card p {
    color: var(--gray-md);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  /* ── CORE VALUES ── */
  .values-section {
    padding: 5rem 0;
    background: white;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .value-card {
    background: var(--gray-sf);
    border-radius: 28px;
    padding: 2.5rem 2rem;
    text-align: center;
    border: 1px solid var(--border);
    transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
  }
  .value-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: var(--red);
  }
  .value-icon {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
    font-size: 2rem;
    transition: transform 0.3s ease;
  }
  .value-card:hover .value-icon {
    transform: scale(1.1) rotate(5deg);
  }
  .value-card h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--charcoal);
    margin-bottom: 0.75rem;
  }
  .value-card p {
    color: var(--gray-md);
    line-height: 1.7;
    font-size: 0.9rem;
  }

  /* ── TEAM CTA ── */
  .team-cta-section {
    padding: 5rem 0;
    background: linear-gradient(135deg, var(--charcoal) 0%, #2d3748 100%);
    color: white;
  }
  .team-cta-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .team-cta-text h2 {
    font-size: 2.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }
  .team-cta-text p {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
    max-width: 500px;
    line-height: 1.7;
  }
  .team-cta-image img {
    width: 100%;
    height: 300px;
